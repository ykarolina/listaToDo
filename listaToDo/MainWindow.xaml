<Window x:Class="listaToDo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:listaToDo"
        mc:Ignorable="d"
        Title="Moja lista zadań" Height="650" Width="535">


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="135"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="115"/>
            <RowDefinition Height="115"/>
            <RowDefinition Height="115"/>
            <RowDefinition Height="14"/>
        </Grid.RowDefinitions>


        <Label Grid.Column="1" Grid.Row="0"
               Grid.ColumnSpan="2"
               Content="Nowe zadanie"
               FontSize="20"
               FontFamily="Comic Sans MS"
               Margin="0,10,0,0"
               VerticalAlignment="Top"
               HorizontalAlignment="Left"/>


        <Border Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"
                Margin="0,4,5,5" Width="215" Height="43"
                Background="#f8f1ee" BorderBrush="#383332"
                BorderThickness="2" CornerRadius="10">
            <TextBox Background="Transparent" BorderThickness="0" x:Name="texttitle" 
                     FontSize="17" FontFamily="Comic Sans MS"
                     HorizontalContentAlignment="Left"
                     VerticalContentAlignment="Center"
                     Margin="5,0"
                     Foreground="Gray"
                     Text="Wpisz zadanie..." GotFocus="texttitle_GotFocus"/>
        </Border>


        <Border Grid.Column="3" Grid.Row="1"
                Margin="13,5,16,4" Height="43"
                Background="#f8f1ee" BorderBrush="#383332"
                BorderThickness="2" CornerRadius="10">
            <DatePicker Background="Transparent" BorderThickness="0" x:Name="datapic" SelectedDateChanged="change_data"
            FontSize="10" FontFamily="Comic Sans MS"
            VerticalContentAlignment="Center"
            Padding="10,0"
            SelectedDateFormat="Short" HorizontalAlignment="Left" Width="42" Margin="48,0,0,0" RenderTransformOrigin="0.799,0.334" Height="39"  VerticalAlignment="Center"/>
        </Border>
        <Border Grid.Column="4" Grid.Row="1"
                Margin="10,7,10,2" Width="115" Height="43"
                Background="#FFE8E8E8" BorderBrush="#383332"
                BorderThickness="2" CornerRadius="10">
            <ComboBox Background="Transparent" BorderThickness="0"
                      FontSize="15" FontFamily="Comic Sans MS"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      FontWeight="Bold" x:Name="comboprio"
                      SelectedIndex="0" Padding="5,0" Margin="4,2,4,1">
                <ComboBoxItem Content="Priorytet" IsEnabled="False" Foreground="Gray"/>
                <ComboBoxItem Content="Niski"/>
                <ComboBoxItem Content="Średni"/>
                <ComboBoxItem Content="Wysoki"/>
            </ComboBox>
        </Border>
        <Label Grid.Column="3" FontSize="14" FontWeight="Bold" FontFamily="Comic Sans MS" Content="data" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Center" Width="52" Margin="23,0,0,0" x:Name="labdata"/>

        <Border Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="3"
        Margin="0,4,5,5" Width="345" Height="55"
        Background="#f8f1ee" BorderBrush="#383332"
        BorderThickness="2" CornerRadius="10">
            <TextBox Background="Transparent" BorderThickness="0"  x:Name="textdescrip"
             FontSize="17" FontFamily="Comic Sans MS"
             HorizontalContentAlignment="Left"
             VerticalContentAlignment="Center"
             Margin="5,0"
             Foreground="Gray"
             Text="Dodaj krótki opis" GotFocus="textdescrip_GotFocus"/>
        </Border>
        <Border Grid.Column="4" Grid.Row="3" Height="48" Width="110" Background="#f783ac" BorderBrush="#383332"
            BorderThickness="2" CornerRadius="10">
            <Button Grid.Column="4" Content="dodaj zadanie" HorizontalAlignment="Center" Click="Button_Click"
                Grid.Row="3" VerticalAlignment="Center" 
                Height="40" Width="95" Background="#f783ac" FontFamily="Comic Sans MS" FontWeight="Bold" BorderBrush="#f783ac" FontSize="13" />
        </Border>
        <Label Grid.Column="1" Content="sortuj wg" HorizontalAlignment="Center" FontFamily="Comic Sans MS" FontWeight="Bold" Grid.Row="4" VerticalAlignment="Center" Grid.RowSpan="2" FontSize="15" Width="100"/>

        <Border Grid.Column="1" Grid.Row="6"
        Margin="0,1,72,1" Height="27"
        Background="#FFE8E8E8" BorderBrush="#383332"
        BorderThickness="2" CornerRadius="10" Grid.ColumnSpan="2">
            <ComboBox Background="Gray" BorderThickness="0"
              FontSize="12" FontFamily="Comic Sans MS"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              FontWeight="Bold"
              SelectedIndex="0" Padding="5,0" Margin="4,2,4,1" x:Name="combosort" SelectionChanged="combosort_SelectionChanged">
                <ComboBoxItem Content="daty"/>
                <ComboBoxItem Content="priorytetu"/>
                <ComboBoxItem Content="status ukończenia"/>
            </ComboBox>
        </Border>
        <RadioButton Grid.Column="2" x:Name="radioAll" Checked="RadioButton_Checked" Content="Wszystkie" FontSize="14" FontFamily="Comic Sans MS"  IsChecked="True" FontWeight="Bold"  HorizontalAlignment="Left" Margin="60,0,0,0" Grid.Row="6" VerticalAlignment="Center" Grid.ColumnSpan="2" />
        <RadioButton Grid.Column="3" x:Name="radioCompleted" Checked="RadioButton_Checked" Content="Ukończone" FontSize="14" FontFamily="Comic Sans MS" FontWeight="Bold"  HorizontalAlignment="Right" Grid.Row="6" VerticalAlignment="Center" RenderTransformOrigin="0.743,0.669"/>
        <RadioButton Grid.Column="4"  x:Name="radioIncomplete" Checked="RadioButton_Checked" Content="Do zrobienia" FontSize="14" FontFamily="Comic Sans MS"  FontWeight="Bold"  HorizontalAlignment="Left" Grid.Row="6" VerticalAlignment="Center" Margin="13,0,0,0" />

        <ScrollViewer Grid.Column="1" Grid.Row="8"   Grid.RowSpan="3" Margin="0,0,12,0" Grid.ColumnSpan="4">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFF8F6F6" CornerRadius="15" Margin="0,0,6,10" Padding="10" BorderBrush="#FFDAD5D5" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>


                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="#333"/>
                                            <TextBlock Text="{Binding DueDate, StringFormat='  {0:dd.MM.yyyy}'}" Foreground="#777" FontSize="12" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}" Foreground="#555" Margin="0,5,0,5"/>
                                    </StackPanel>


                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">

                                        <Button Width="35" Height="35" Margin="10,0,10,10" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" x:Name="buttontra" Click="DeleteTask_Click" >
                                            <Image Source="/kosz.jpg" Stretch="Uniform" />
                                        </Button>
                                        <Border Grid.Column="4" Grid.Row="3" Height="40" Width="100" Background="#fcc2d7"
                                                BorderBrush="#383332" BorderThickness="2" CornerRadius="10">
                                            <Button x:Name="buttonzak" FontSize="12" Padding="10,2" Height="30" Width="90" Background="Transparent" FontWeight="Bold" BorderBrush="#fcc2d7" Click="buttonzak_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="zakończ" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Content" Value="zakończone" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>




    </Grid>
</Window>
